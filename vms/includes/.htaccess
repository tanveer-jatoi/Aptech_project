# =====================================================================
# Vaccination Management System (VMS)
# Block all direct HTTP/HTTPS browser access to includes/ folder
# PHP scripts can still safely require/include these files locally.
# =====================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
